# NivaGlow Platform - Environment Configuration
# See each package's own .env for specific variables

# Root
PORT=3000
NODE_ENV=development

# Database
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/nivaglow"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/nivaglow"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nivaglow?schema=public"

# Auth
JWT_SECRET="your_jwt_secret_key_minimum_32_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_minimum_32_chars"
BCRYPT_SALT_ROUNDS=10

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token"
WHATSAPP_GRAPH_VERSION="v23.0"

# OpenAI
OPENAI_API_KEY="your_openai_api_key"

# APIs (to be configured per merchant)
D2C_ORDER_API_URL="http://localhost:4000/api/orders"
D2C_RETURN_API_URL="http://localhost:4000/api/returns"
D2C_PRODUCT_API_URL="http://localhost:4000/api/products"
D2C_TICKET_API_URL="http://localhost:4000/api/tickets"
D2C_PROACTIVE_QUEUE_URL="http://localhost:4000/api/proactive-queue"
SARVAM_VOICE_AGENT_URL="https://api.sarvam.ai/v1/voice-agent"

# Meta Webhook verification
WHATSAPP_VERIFY_TOKEN="niva-glow-verify-token"